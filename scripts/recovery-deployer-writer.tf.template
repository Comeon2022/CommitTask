# Temporary recovery-only resource used to import the OLD builder permission
# into reconstructed state, then removed from configuration so Terraform plans
# its revocation. DO NOT commit this as a real .tf file in terraform/bootstrap.
resource "google_artifact_registry_repository_iam_member" "deployer_push" {
  project    = var.project_id
  location   = var.region
  repository = google_artifact_registry_repository.api.name
  role       = "roles/artifactregistry.writer"
  member     = "serviceAccount:${google_service_account.identity["deployer"].email}"
}
