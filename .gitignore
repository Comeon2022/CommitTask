.env
.env.*
!.env.example
*.pem
*.key
*service-account*.json
*credentials*.json
*.p12

# Python, Node and IDE files
__pycache__/
*.py[cod]
.venv/
node_modules/
dist/
.next/
.vscode/
.idea/
.DS_Store
