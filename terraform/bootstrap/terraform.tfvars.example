# Copy locally to terraform.tfvars (never commit real identities).
project_id        = "commitask"
project_number    = "924903658971"
region            = "europe-west1"
state_bucket_name = "commitask-tfstate-924903658971"

# Omit these until actual Google accounts are available.
# developer_emails = {
#   dev1 = "dev1@example.com"
#   dev2 = "dev2@example.com"
#   dev3 = "dev3@example.com"
# }

# Human identity to run Terraform locally by short-lived SA impersonation.
# Set the real Google account email after creating your GCP project.
terraform_operator_email = "karu.lior@gmail.com"
reviewer_principal_type  = "group" # Confirmed by Google Cloud IAM error

# Verified GitHub repository identifiers. WIF trust checks immutable IDs as
# well as the full repository name. These are variables, not literals in OIDC code.
github_repository_full_name = "Comeon2022/CommitTask"
github_repository_id        = "1453727041"
github_owner_id             = "104059889"
